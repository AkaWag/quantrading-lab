//@version=6
strategy("QT Institutional Strategy Template v2.5", overlay=true,
     initial_capital=100000, pyramiding=0,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=1, process_orders_on_close=true)

// === Research metadata ===
string GROUP_META = "Research metadata"
string researchId = input.string("QT-000", "Research ID", group=GROUP_META)

// === Test controls ===
string GROUP_TEST = "Test controls"
time startDate = input.time(timestamp("2020-01-01"), "Start", group=GROUP_TEST)
time endDate   = input.time(timestamp("2030-01-01"), "End", group=GROUP_TEST)
bool inWindow = time >= startDate and time <= endDate

// === Signal inputs (replace only from an approved specification) ===
string GROUP_SIGNAL = "Signal"
int fastLen = input.int(20, "Fast length", minval=1, group=GROUP_SIGNAL)
int slowLen = input.int(50, "Slow length", minval=2, group=GROUP_SIGNAL)
float fast = ta.ema(close, fastLen)
float slow = ta.ema(close, slowLen)
bool longSignal = barstate.isconfirmed and ta.crossover(fast, slow)
bool exitSignal = barstate.isconfirmed and ta.crossunder(fast, slow)

// === Risk ===
string GROUP_RISK = "Risk"
int atrLen = input.int(14, "ATR length", minval=1, group=GROUP_RISK)
float atrMult = input.float(2.0, "ATR stop multiple", minval=0.1, step=0.1, group=GROUP_RISK)
float atr = ta.atr(atrLen)
var float activeStop = na

if longSignal and inWindow and strategy.position_size == 0
    activeStop := close - atr * atrMult
    strategy.entry("L", strategy.long)

if strategy.position_size > 0
    strategy.exit("L-Risk", "L", stop=activeStop)
    if exitSignal or not inWindow
        strategy.close("L", comment="Signal/window exit")

if strategy.position_size == 0
    activeStop := na

plot(fast, "Fast")
plot(slow, "Slow")
plot(strategy.position_size > 0 ? activeStop : na, "Active stop", style=plot.style_linebr)

alertcondition(longSignal and inWindow, "Long candidate", "Research signal only; validate alert workflow before automation.")
