# Copy to tools/dizzy/.env (gitignored). Never commit real tokens.
# Prefer a Discord bot token for a bot invited only to authorized servers/channels.
# User-account tokens are prohibited by QuanTrading Dizzy policy and Discord ToS for automation.

DISCORD_TOKEN=
# Optional alternate name used by some docs; export wrapper accepts either.
# DISCORD_BOT_TOKEN=

# Optional: override CLI binary path after install
# DIZZY_DCE_BIN=

# Export defaults
DIZZY_EXPORT_FORMAT=Json
DIZZY_INCLUDE_THREADS=Active
DIZZY_MEDIA=true
DIZZY_UTC=true
